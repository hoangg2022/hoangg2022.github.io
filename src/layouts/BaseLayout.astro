---
// Layout mặc định: Tất cả các trang đều phải sử dụng layout này để tính năng hình nền và thanh điều hướng hoạt động bình thường
import '../styles/global.css';
import { site } from '../site.config';
import ThemeToggle from '../components/ThemeToggle.astro';
import WallpaperPicker from '../components/WallpaperPicker.astro';

const {
  title,
  ogType = 'website',
  ogDescription = site.description,
  jsonLd,
} = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : site.defaultTitle;
// Tên miền trang web dùng cho SEO (Nếu site.url trống sẽ dùng tên miền placeholder)
const siteUrl = site.url || 'https://example.com';
const currentPath = Astro.url.pathname;

function navClass(href: string) {
  const isActive = currentPath === href;
  return isActive
    ? 'text-accent bg-accent/10 font-medium'
    : 'text-fg/60 hover:text-accent hover:bg-fg/5';
}
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    
    <meta name="description" content={ogDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={new URL(site.ogImage, siteUrl).href} />
    <meta property="og:site_name" content={site.ogSiteName} />
    <meta property="og:url" content={new URL(Astro.url.pathname, siteUrl).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={new URL(site.ogImage, siteUrl).href} />
    <link rel="canonical" href={new URL(Astro.url.pathname, siteUrl).href} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{pageTitle}</title>

  <script is:inline>
  // Cấu hình thay đổi icon trang web ở đây (mặc định dùng favicon.png): <link rel="icon" type="image/png" href="/favicon.png" />
  
  // ===== Lớp 1: Chống nhấp nháy giao diện khi tải trang đầu (FOUC) =====
  // Phải thực thi đồng bộ trong <head> để thiết lập theme trước khi trình duyệt render khung hình đầu tiên
  (function () {
    var stored = localStorage.getItem('theme');
    var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    var theme = stored || (prefersDark ? 'dark' : 'light');
    document.documentElement.setAttribute('data-theme', theme);
  })();

  // ===== Lớp 2: Chống nhấp nháy giao diện khi chuyển trang bằng ClientRouter =====
  // ClientRouter điều hướng không chạy lại inline script, phải lắng nghe sự kiện astro:after-swap để cập nhật lại theme
  function applyTheme() {
    var stored = localStorage.getItem('theme');
    var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    var theme = stored || (prefersDark ? 'dark' : 'light');
    document.documentElement.setAttribute('data-theme', theme);
  }
  document.addEventListener('astro:after-swap', applyTheme);
  </script>
  </head>

  <body class="bg-bg text-fg min-h-screen flex flex-col">
    <!-- Thanh điều hướng Header: Logo bên trái, Menu/Theme/Wallpaper bên phải -->
    <header class="sticky top-4 z-50">
      <div class="flex items-center justify-between w-full px-20 py-4
                  bg-bg/15 backdrop-blur-2xl
                  shadow-lg shadow-black/5
                  text-lg
                  max-md:gap-3 max-md:px-4 max-md:py-2 max-md:text-sm">
        <a href="/" class:list={['px-3 py-1.5 max-md:px-2.5 max-md:py-1 rounded-full transition-all duration-200', navClass('/')]}>{site.name}</a>

        <!-- Bên phải: Navigation máy tính + Nút chuyển giao diện / hình nền -->
        <div class="flex items-center gap-1">
          <!-- Navigation máy tính (Màn hình md trở lên) -->
          <nav class="hidden md:flex items-center gap-1">
            {site.nav.map((item) => (
              <a href={item.href} class:list={['px-3 py-1.5 rounded-full transition-all duration-200', navClass(item.href)]}>{item.label}</a>
            ))}
          </nav>
          <ThemeToggle />
          <WallpaperPicker />
          <!-- Nút Hamburger Menu: Chỉ hiển thị trên thiết bị di động -->
          <button
            id="menu-btn"
            class="md:hidden p-1.5 rounded-full hover:bg-fg/10 transition-colors"
            aria-label="Mở menu điều hướng"
            aria-expanded="false"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <!-- Menu xổ xuống trên thiết bị di động: Đặt ngoài header để tránh hiệu ứng backdrop-filter ảnh hưởng đến thuộc tính fixed -->
    <div
      id="mobile-menu"
      class="md:hidden fixed top-24 right-4 z-[60] w-56
             bg-bg/85 backdrop-blur-xl
             rounded-2xl shadow-xl shadow-black/10
             ring-1 ring-fg/10
             scale-95 opacity-0 pointer-events-none
             transition-all duration-200 ease-out
             flex flex-col p-2"
    >
      {site.nav.map((item) => (
        <a
          href={item.href}
          class:list={['px-3 py-2.5 rounded-xl text-sm transition-colors', navClass(item.href)]}
        >
          {item.label}
        </a>
      ))}
    </div>

    <!-- <slot /> là vị trí chèn nội dung của từng trang -->
    <main class="flex-1">
      <slot />
    </main>
    <footer class="px-8 py-6 border-t border-fg/10 text-sm opacity-60">
      {site.name}
    </footer>

  <script>
    // ===== Menu Hamburger trên di động (Event Delegation + Dynamic Query, duy trì hoạt động tốt với ClientRouter) =====
    let menuOpen = false;

    function getMenu() {
      return document.getElementById('mobile-menu');
    }

    function setMenu(open: boolean) {
      menuOpen = open;
      const menu = getMenu();
      if (!menu) return;
      menu.classList.toggle('opacity-0', !open);
      menu.classList.toggle('scale-95', !open);
      menu.classList.toggle('pointer-events-none', !open);
      menu.classList.toggle('opacity-100', open);
      menu.classList.toggle('scale-100', open);
      const btn = document.getElementById('menu-btn');
      if (btn) btn.setAttribute('aria-expanded', String(open));
    }

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      // Nhấp nút hamburger: Bật / Tắt menu
      if (target?.closest('#menu-btn')) {
        setMenu(!menuOpen);
        return;
      }
      // Nhấp vào liên kết trong menu: Đóng menu
      if (target?.closest('#mobile-menu a')) {
        setMenu(false);
        return;
      }
      // Nhấp ra ngoài vùng menu: Đóng menu
      if (menuOpen && !target?.closest('#mobile-menu')) {
        setMenu(false);
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menuOpen) setMenu(false);
    });
  </script>

  </body>
</html>
