---
// Trang 404
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 - Không tìm thấy trang">
  <div class="max-w-2xl mx-auto px-6 pt-32 pb-16 text-center">
    <p class="text-xs tracking-[0.3em] uppercase text-fg/30 mb-3">404 ERROR</p>
    <h1 class="text-6xl font-bold text-accent">--- Mất Kết Nối ---</h1>
    <p class="mt-6 text-fg/50 text-lg">Scan/Tìm kiếm cái gì đấy??? Lỗ hổng không nằm ở đây đâu!</p>
    <a href="/" class="mt-8 inline-block px-6 py-2 rounded-full bg-accent text-white hover:opacity-80 transition-opacity">
      Quay về trang chủ
    </a>
  </div>
</BaseLayout>
