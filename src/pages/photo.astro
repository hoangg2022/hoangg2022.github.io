---
// Trang Ảnh & Album: Hợp tác hiển thị các bộ sưu tập ảnh (AlbumCard Component)
import BaseLayout from '../layouts/BaseLayout.astro';
import AlbumCard from '../components/AlbumCard.astro';
---

<BaseLayout title="Hình ảnh & Album">
  <div class="max-w-4xl mx-auto px-6 pt-24 pb-16">
    <p class="text-xs tracking-[0.3em] uppercase text-fg/30 mb-3">PHOTO / BỘ BỘ SƯU TẬP</p>
    <h1 class="text-3xl font-bold mb-8">Hình ảnh</h1>
    <AlbumCard />
  </div>
</BaseLayout>
