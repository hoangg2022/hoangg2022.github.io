---
// Trang Giới thiệu bản thân (About Me)
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site.config';
---

<BaseLayout title="Giới thiệu">
  <div class="max-w-2xl mx-auto px-6 pt-24 pb-16">
    <!-- Tiêu đề & Tag -->
    <p class="text-xs tracking-[0.3em] uppercase text-fg/30 mb-3">ABOUT / GIỚI THIỆU</p>
    <h1 class="text-3xl font-bold mb-8">Xin chào, tôi là {site.author.name} 👋</h1>

    <!-- Giới thiệu chung từ file site.config.ts -->
    <p class="text-fg/80 leading-relaxed text-lg">
      {site.about}
    </p>

    <!-- Định hướng & Lĩnh vực nghiên cứu (Focus Areas) -->
    <div class="mt-10 border-t border-fg/10 pt-8">
      <h2 class="text-xl font-semibold mb-4 text-accent">🎯 Lĩnh vực nghiên cứu</h2>
      <ul class="list-disc list-inside space-y-2 text-fg/70">
        <li><strong>Web Application Security:</strong> Khai thác & phòng chống các lỗ hổng Web (OWASP Top 10, Business Logic Flaws, API Security).</li>
        <li><strong>Pentest & Red Teaming:</strong> Phân tích bề mặt tấn công, Privilege Escalation, Active Directory Exploitation.</li>
        <li><strong>Vulnerability Research:</strong> Phân tích kịch bản tấn công, dựng PoC và viết kịch bản khai thác cho các lỗ hổng CVE mới.</li>
        <li><strong>Capture The Flag (CTF):</strong> Thực hành kỹ năng giải lab thực tế trên Hack The Box, TryHackMe, PortSwigger Web Security Academy.</li>
      </ul>
    </div>

    <!-- Thông tin liên hệ & Mạng xã hội -->
    <div class="mt-10 border-t border-fg/10 pt-8">
      <h2 class="text-xl font-semibold mb-4">📫 Liên kết & Kết nối</h2>
      <div class="space-y-3 text-fg/70">
        <p class="flex items-center gap-2">
          <span>🐙 GitHub:</span>
          <a href={`https://github.com/${site.author.github}`} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline font-mono">
            @{site.author.github}
          </a>
        </p>
        <p class="flex items-center gap-2">
          <span>📍 Vị trí:</span>
          <span>{site.author.location}</span>
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
