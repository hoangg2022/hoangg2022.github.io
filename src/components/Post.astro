---
// Component danh sách bài viết blog: Đọc bài viết, sắp xếp theo ngày, hiển thị dạng thẻ
import { getCollection } from 'astro:content';
import AnimateIn from './AnimateIn.astro';
import ReadFrostedGlass from './ReadFrostedGlass.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.localeCompare(a.data.pubDate),
);
---

<div class="max-w-2xl mx-auto px-6 pt-24 pb-16">
  <p class="text-xs tracking-[0.3em] uppercase text-fg/30 mb-3">BLOG / BÀI VIẾT</p>
  <h1 class="text-3xl font-bold mb-8">Danh sách bài viết</h1>

  {posts.length === 0 ? (
    <p class="text-fg/50">Chưa có bài viết nào.</p>
  ) : (
    <div class="flex flex-col gap-4">
      {posts.map((post, i) => {
        const { title, description, pubDate, category, tags } = post.data;
        const href = `/blog/${post.id}`;
        return (
          <AnimateIn delay={i * 80}>
            <a href={href} class="block group transition-all duration-300
                                hover:-translate-y-0.5">
              <ReadFrostedGlass>
                <!-- Tiêu đề -->
                <h2 class="text-lg font-bold text-fg group-hover:text-accent
                           transition-colors duration-200 leading-snug">
                  {title}
                </h2>

                <!-- Mô tả / Tiêu đề phụ -->
                <p class="mt-2 text-sm text-fg/50 leading-relaxed line-clamp-2">
                  {description}
                </p>

                <!-- Phần chân thẻ: Ngày đăng + Thẻ tag + Danh mục -->
                <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2">
                  <!-- Ngày đăng -->
                  <time datetime={pubDate} class="text-xs text-fg/35 font-mono">
                    {pubDate}
                  </time>

                  <!-- Thẻ (Tags) -->
                  {tags && tags.length > 0 && (
                  <div class="flex flex-wrap gap-1.5">
                    {tags.map((tag) => (
                      <span class="text-xs text-fg/40 hover:text-accent transition-colors">
                        #{tag}
                      </span>
                    ))}
                  </div>
                  )}

                  <!-- Nhãn danh mục (Bên phải) -->
                  {category && (
                  <span class="ml-auto text-xs font-medium tracking-wide uppercase
                               text-accent bg-accent/10 px-2.5 py-1 rounded-full">
                    {category}
                  </span>
                  )}
                </div>
              </ReadFrostedGlass>
            </a>
          </AnimateIn>
        );
      })}
    </div>
  )}
</div>
