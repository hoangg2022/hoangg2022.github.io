---
// Component thẻ album ảnh: Kiểm tra các thư mục album trong src/assets/album/, tạo hiệu ứng 3 lớp ảnh chồng lên nhau
// Sắp xếp: Dựa theo thời gian chỉnh sửa của ảnh mới nhất trong album (mới nhất xếp trước)
// Ảnh bìa được tối ưu tự động bằng astro:assets (định dạng webp, độ rộng 600px)
import fs from 'node:fs';
import path from 'node:path';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import AnimateIn from './AnimateIn.astro';

const albumRoot = path.join(process.cwd(), 'src', 'assets', 'album');
const imageExt = /\.(jpg|jpeg|png|webp|gif|avif)$/i;

// Import động toàn bộ ảnh album (phân tích tĩnh khi build, tự động bao gồm khi thêm ảnh mới vào thư mục)
const albumModules = import.meta.glob(
  '/src/assets/album/**/*.{jpg,jpeg,png,webp,gif,avif}',
  { eager: true },
) as Record<string, { default: ImageMetadata }>;

let albums: { name: string; images: string[]; mtime: number }[] = [];

// Nếu thư mục src/assets/album không tồn tại, trả về mảng rỗng để đảm bảo quá trình build không bị lỗi
if (fs.existsSync(albumRoot)) {
  const dirs = fs.readdirSync(albumRoot, { withFileTypes: true })
    .filter((d) => d.isDirectory());
  for (const d of dirs) {
    const dir = path.join(albumRoot, d.name);
    const files = fs.readdirSync(dir).filter((f) => imageExt.test(f)).sort();
    const images: string[] = [];
    let mtime = 0;
    for (const f of files) {
      // Khớp đường dẫn để tìm ImageMetadata tương ứng
      const key = Object.keys(albumModules).find((k) => k.includes(`/${d.name}/${f}`));
      const meta = key ? albumModules[key]?.default : undefined;
      if (meta) {
        try {
          const opt = await getImage({ src: meta, width: 600, format: 'webp' });
          images.push(opt.src);
        } catch {
          images.push('/favicon.png');
        }
      }
      const t = fs.statSync(path.join(dir, f)).mtimeMs;
      if (t > mtime) mtime = t;
    }
    albums.push({ name: d.name, images, mtime });
  }
  albums = albums
    .filter((a) => a.images.length > 0)
    .sort((a, b) => b.mtime - a.mtime);
}
---

<div class="grid grid-cols-3 gap-4">
  {albums.length === 0 ? (
    <p class="text-fg/50 col-span-3">Chưa có album ảnh nào.</p>
  ) : (
    albums.map((album, i) => (
      <AnimateIn delay={i * 80}>
        <a
          href={`/photo/${encodeURIComponent(album.name)}`}
          class="block group transition-all duration-300 hover:-translate-y-0.5"
        >
          <!-- Khung chứa trong suốt: Giữ lại hiệu ứng chữ và ảnh -->
          <div class="p-3">
            <!-- 3 lớp ảnh chồng lên nhau: Ảnh 1 ở trên cùng (0°), Ảnh 2 ở giữa (20°), Ảnh 3 ở dưới cùng (-210°) -->
            <div class="relative aspect-square">
              {album.images[2] && (
                <img
                  src={album.images[2]}
                  alt=""
                  loading="lazy"
                  class="absolute inset-0 w-full h-full object-cover rounded-xl shadow-md
                         -rotate-[210deg] translate-x-[-10px] translate-y-[12px] scale-[0.86]
                         opacity-90 z-10"
                />
              )}
              {album.images[1] && (
                <img
                  src={album.images[1]}
                  alt=""
                  loading="lazy"
                  class="absolute inset-0 w-full h-full object-cover rounded-xl shadow-md
                         rotate-[20deg] translate-x-[8px] translate-y-[-8px] scale-[0.93]
                         opacity-95 z-20"
                />
              )}
              {album.images[0] && (
                <img
                  src={album.images[0]}
                  alt={album.name}
                  loading="lazy"
                  class="absolute inset-0 w-full h-full object-cover rounded-xl shadow-lg z-30
                         transition-transform duration-300 group-hover:scale-[1.03]"
                />
              )}
            </div>

            <!-- Thông tin Album: Tên album canh giữa nằm dưới khung ảnh -->
            <div class="mt-3 text-center px-1">
              <h2 class="text-base font-bold text-fg group-hover:text-accent transition-colors duration-200 truncate">
                {album.name}
              </h2>
              <span class="text-xs text-fg/40 font-mono block mt-0.5">{album.images.length} ảnh</span>
            </div>
          </div>
        </a>
      </AnimateIn>
    ))
  )}
</div>
