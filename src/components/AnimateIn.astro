---
// Component wrapper tạo hiệu ứng xuất hiện (entrance animation) dùng chung
// Cách dùng: <AnimateIn delay={100}> <Nội dung của bạn /> </AnimateIn>
// delay tính bằng mili-giây (ms), dùng để làm hiệu ứng xuất hiện so-le cho danh sách, mặc định là 0
export interface Props {
  delay?: number;
}

const { delay = 0 } = Astro.props;
---

<div
  class="animate-in"
  style={`animation-delay: ${delay}ms;`}
>
  <slot />
</div>

<style>
  .animate-in {
    /* Hiệu ứng xuất hiện: Phóng to từ tâm ra ngoài + Phóng lớn & Hiện dần (cảm giác sóng nước lan tỏa) */
    /* Trạng thái tĩnh không ẩn hoàn toàn để tránh hiện tượng nhấp nháy background khi chuyển trang, animation chạy sẽ fade-in dần */
    transform: scale(0.6);
    animation: rippleIn 0.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @keyframes rippleIn {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
    70% {
      transform: scale(1.012); /* Hiệu ứng nảy nhẹ dạng sóng nước (tăng tính mượt mà) */
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
</style>
