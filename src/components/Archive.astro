---
// Dòng thời gian lưu trữ: Đường kẻ dọc bên trái + Nhóm theo năm + Có thể thu gọn/mở rộng, hiển thị ngày tháng trước bài viết
import { getCollection } from 'astro:content';
import ReadFrostedGlass from './ReadFrostedGlass.astro';
import AnimateIn from './AnimateIn.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.localeCompare(a.data.pubDate),
);

const byYear: Record<string, typeof posts> = {};
for (const post of posts) {
  const year = post.data.pubDate.split('-')[0];
  (byYear[year] ??= []).push(post);
}

const years = Object.keys(byYear).sort((a, b) => b.localeCompare(a));
const latestYear = years[0];

// Định dạng ngày/tháng theo chuẩn tiếng Việt (ví dụ: 15 thg 08)
function formatMonthDay(dateStr: string) {
  const [, month, day] = dateStr.split('-');
  return `${parseInt(day)} thg ${parseInt(month)}`;
}

// Thu thập toàn bộ các thẻ tag duy nhất xuất hiện trong các bài viết (dùng cho thanh lọc tag)
const allTags = [...new Set(
  posts.flatMap((post) => post.data.tags ?? []),
)].sort((a, b) => a.localeCompare(b));
---

<div class="max-w-2xl mx-auto px-6 pt-24 pb-16">
  <p class="text-xs tracking-[0.3em] uppercase text-fg/30 mb-3">TIMELINE / DÒNG THỜI GIAN</p>
  <h1 class="text-3xl font-bold mb-6">Lưu trữ bài viết</h1>

  <!-- Thanh tìm kiếm: Lọc tức thì theo tiêu đề / thẻ tag -->
  <input
    id="archive-search"
    type="search"
    placeholder="🔍 Tìm kiếm tiêu đề bài viết hoặc thẻ tag…"
    class="w-full px-4 py-2.5 rounded-xl text-sm
           bg-bg/60 border border-fg/10
           text-fg placeholder:text-fg/30
           focus:outline-none focus:border-accent/50 focus:ring-2 focus:ring-accent/20
           transition-colors"
  />

  <!-- Thanh thẻ tag: Tự động tổng hợp tag từ các bài viết, cho phép chọn nhiều tag -->
  {allTags.length > 0 && (
    <div id="archive-tags" class="flex flex-wrap gap-2 mt-4">
      {allTags.map((tag) => (
        <button
          type="button"
          data-tag={tag}
          class="tag-btn px-2.5 py-1 rounded-full text-xs
                 bg-fg/5 text-fg/60 border border-fg/10
                 hover:border-accent/40 hover:text-accent
                 transition-colors"
        >
          #{tag}
        </button>
      ))}
    </div>
  )}

  <hr class="border-fg/10 mb-8 mt-6" />

  <ReadFrostedGlass>
  {posts.length === 0 ? (
    <p class="text-fg/50">Chưa có bài viết nào.</p>
  ) : (
    <div class="relative">
      <!-- Đường kẻ dọc thời gian -->
      <div class="absolute left-[13px] top-2 bottom-2 w-px bg-fg/10"></div>

      <div class="flex flex-col">
        <p id="archive-empty" class="hidden text-fg/50 text-center py-10">Không tìm thấy bài viết phù hợp.</p>
        <style>
          summary::-webkit-details-marker{display:none}
          summary::marker{content:""}
          details[open] .archive-arrow{transform:rotate(90deg)}
        </style>
        {years.map((year, i) => {
          const yearPosts = byYear[year];
          const isLatest = year === latestYear;
          return (
            <AnimateIn delay={i * 100}>
            <details
              class="relative archive-year"
              data-year={year}
              open={isLatest}
            >
              {/* Dòng năm tổng quan: Nút tròn tương tác (có mũi tên) + Năm + Số lượng bài */}
              <summary class="flex items-center gap-6 cursor-pointer
                               py-3">

                {/* Nút tròn trên dòng thời gian — Có mũi tên thu gọn/mở rộng */}
                <div class={`relative z-10 w-[26px] h-[26px] rounded-full shrink-0 border-2 flex items-center justify-center transition-all duration-300 ${
                  isLatest
                    ? 'bg-accent border-accent'
                    : 'bg-bg border-accent/30'
                }`}>
                  <svg
                    class={`archive-arrow w-3.5 h-3.5 shrink-0 transition-transform duration-200 ${
                      isLatest ? 'text-white' : 'text-accent'
                    }`}
                    fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"
                  >
                    <path d="M9 5l7 7-7 7" />
                  </svg>
                </div>

                {/* Năm + Số lượng bài viết */}
                <span class={`text-xl font-semibold transition-colors duration-200 ${
                  isLatest ? 'text-accent' : 'text-accent/45'
                }`}>
                  {year}
                  <span class="ml-1.5 text-sm font-normal opacity-60">({yearPosts.length})</span>
                </span>
              </summary>

              {/* Danh sách bài viết trong năm đó (mở ra khi nhấp vào năm) */}
              <div class="ml-[50px] mt-2 mb-8 flex flex-col gap-3">
                {yearPosts.map((post) => (
                  <a
                    href={`/blog/${post.id}`}
                    data-title={post.data.title}
                    data-tags={(post.data.tags ?? []).join(' ')}
                    class="archive-item flex items-baseline gap-4 text-base leading-relaxed
                           text-fg/50 hover:text-accent transition-colors duration-200"
                  >
                    <!-- Ngày tháng (Ngày thg Tháng) -->
                    <span class="text-sm text-fg/25 font-mono shrink-0 w-20 text-right">
                      {formatMonthDay(post.data.pubDate)}
                    </span>
                    <!-- Tiêu đề bài viết -->
                    <span>{post.data.title}</span>
                  </a>
                ))}
              </div>
            </details>
            </AnimateIn>
          );
        })}
      </div>
    </div>
  )}
  </ReadFrostedGlass>
</div>

<script define:vars={{ allTags }}>
  // ===== Tìm kiếm + Lọc đa thẻ tag cho Lưu trữ (Lọc trực tiếp trên DOM, tối ưu SEO) =====
  const searchInput = document.getElementById('archive-search');
  const tagBar = document.getElementById('archive-tags');
  const items = Array.from(document.querySelectorAll('.archive-item'));
  const yearGroups = Array.from(document.querySelectorAll('.archive-year'));
  const emptyTip = document.getElementById('archive-empty');

  let query = '';
  const selectedTags = new Set();

  function matches(item) {
    const title = (item.dataset.title || '').toLowerCase();
    const tags = (item.dataset.tags || '').toLowerCase();
    // Từ khóa tìm kiếm: Khớp với tiêu đề hoặc thẻ tag
    if (query && !title.includes(query) && !tags.includes(query)) return false;
    // Đa thẻ tag: Bài viết phải chứa tất cả các thẻ tag đã chọn
    for (const t of selectedTags) {
      if (!tags.includes(t)) return false;
    }
    return true;
  }

  function applyFilter() {
    let visibleCount = 0;
    for (const item of items) {
      const show = matches(item);
      item.classList.toggle('hidden', !show);
      if (show) visibleCount++;
    }
    // Nhóm năm: Nếu không có bài viết nào hiển thị trong năm đó thì ẩn toàn bộ nhóm (bao gồm cả container AnimateIn)
    for (const group of yearGroups) {
      const anyVisible = Array.from(group.querySelectorAll('.archive-item'))
        .some((i) => !i.classList.contains('hidden'));
      const container = group.closest('.animate-in') || group;
      container.classList.toggle('hidden', !anyVisible);
    }
    // Thông báo khi không tìm thấy kết quả
    if (emptyTip) emptyTip.classList.toggle('hidden', visibleCount > 0);
  }

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      query = e.target.value.trim().toLowerCase();
      applyFilter();
    });
  }

  if (tagBar) {
    tagBar.addEventListener('click', (e) => {
      const btn = e.target.closest('.tag-btn');
      if (!btn) return;
      // Chuyển sang chữ thường để đồng bộ với so sánh dataset.tags
      const tag = (btn.dataset.tag || '').toLowerCase();
      if (selectedTags.has(tag)) {
        // Bỏ chọn tag
        selectedTags.delete(tag);
        btn.classList.remove('bg-accent', 'text-white', 'border-accent');
        btn.classList.add('bg-fg/5', 'text-fg/60', 'border-fg/10');
      } else {
        // Chọn tag
        selectedTags.add(tag);
        btn.classList.remove('bg-fg/5', 'text-fg/60', 'border-fg/10');
        btn.classList.add('bg-accent', 'text-white', 'border-accent');
      }
      applyFilter();
    });
  }
</script>
